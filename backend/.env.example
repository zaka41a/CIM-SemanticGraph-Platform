# Groq API Configuration (RECOMMENDED - Fast & Free)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: Choose your model (default: llama-3.3-70b-versatile)
# Available models: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (Fallback - Local LLM)
# Only needed if not using Groq
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# Claude API Configuration (Optional - Not currently used in GraphRAG)
CLAUDE_API_KEY=your-claude-api-key-here

# JWT Secret (Change in production)
JWT_SECRET=your-secret-key-change-in-production-minimum-256-bits
