# Default chat provider: gpt5 (KI Connect) or groq
LLM_DEFAULT_PROVIDER=gpt5

# KI Connect
KICONNECT_API_KEY=
KICONNECT_BASE_URL=https://chat.kiconnect.nrw/api/v1
KICONNECT_MODEL=gpt-5.5

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Claude agent (optional)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-fable-5

# Vector embeddings (optional)
OPENAI_API_KEY=

# Local model fallback (optional; requires a running Ollama server)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# Local services
JENA_FUSEKI_REMOTE_URL=http://localhost:3030
JENA_FUSEKI_DATASET=cim
JENA_FUSEKI_USERNAME=admin
JENA_FUSEKI_PASSWORD=admin
QDRANT_URL=http://localhost:6333
POWERFLOW_SERVICE_URL=http://localhost:8000
