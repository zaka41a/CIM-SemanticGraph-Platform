<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:cim="http://iec.ch/TC57/CIM100#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <!-- ================= BASE VOLTAGES ================= -->
    <cim:BaseVoltage rdf:ID="BaseVoltage_110kV">
        <cim:IdentifiedObject.name>110kV</cim:IdentifiedObject.name>
        <cim:BaseVoltage.nominalVoltage>110000</cim:BaseVoltage.nominalVoltage>
    </cim:BaseVoltage>

    <cim:BaseVoltage rdf:ID="BaseVoltage_220kV">
        <cim:IdentifiedObject.name>220kV</cim:IdentifiedObject.name>
        <cim:BaseVoltage.nominalVoltage>220000</cim:BaseVoltage.nominalVoltage>
    </cim:BaseVoltage>

    <!-- ================= SUBSTATIONS ================= -->
    <cim:Substation rdf:ID="Substation_A">
        <cim:IdentifiedObject.name>Substation A</cim:IdentifiedObject.name>
    </cim:Substation>

    <cim:Substation rdf:ID="Substation_B">
        <cim:IdentifiedObject.name>Substation B</cim:IdentifiedObject.name>
    </cim:Substation>

    <!-- ================= VOLTAGE LEVELS ================= -->
    <cim:VoltageLevel rdf:ID="VoltageLevel_220kV_A">
        <cim:IdentifiedObject.name>220kV Level A</cim:IdentifiedObject.name>
        <cim:VoltageLevel.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
        <cim:VoltageLevel.Substation rdf:resource="#Substation_A"/>
    </cim:VoltageLevel>

    <cim:VoltageLevel rdf:ID="VoltageLevel_110kV_B">
        <cim:IdentifiedObject.name>110kV Level B</cim:IdentifiedObject.name>
        <cim:VoltageLevel.BaseVoltage rdf:resource="#BaseVoltage_110kV"/>
        <cim:VoltageLevel.Substation rdf:resource="#Substation_B"/>
    </cim:VoltageLevel>

    <!-- ================= CONNECTIVITY NODES (Busbars) ================= -->
    <cim:ConnectivityNode rdf:ID="Bus_A">
        <cim:IdentifiedObject.name>Bus A</cim:IdentifiedObject.name>
        <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="#VoltageLevel_220kV_A"/>
    </cim:ConnectivityNode>

    <cim:ConnectivityNode rdf:ID="Bus_B">
        <cim:IdentifiedObject.name>Bus B</cim:IdentifiedObject.name>
        <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="#VoltageLevel_110kV_B"/>
    </cim:ConnectivityNode>

    <!-- ================= GENERATORS ================= -->
    <cim:GeneratingUnit rdf:ID="Gen_A">
        <cim:IdentifiedObject.name>Generator A</cim:IdentifiedObject.name>
        <cim:GeneratingUnit.maxOperatingP>100</cim:GeneratingUnit.maxOperatingP>
        <cim:Equipment.EquipmentContainer rdf:resource="#Substation_A"/>
    </cim:GeneratingUnit>

    <cim:GeneratingUnit rdf:ID="Gen_B">
        <cim:IdentifiedObject.name>Generator B</cim:IdentifiedObject.name>
        <cim:GeneratingUnit.maxOperatingP>50</cim:GeneratingUnit.maxOperatingP>
        <cim:Equipment.EquipmentContainer rdf:resource="#Substation_B"/>
    </cim:GeneratingUnit>

    <!-- ================= AC LINE ================= -->
    <cim:ACLineSegment rdf:ID="Line_A_B">
        <cim:IdentifiedObject.name>Line A-B 220kV</cim:IdentifiedObject.name>
        <cim:Conductor.length>25.0</cim:Conductor.length>
        <cim:ACLineSegment.r>0.12</cim:ACLineSegment.r>
        <cim:ACLineSegment.x>0.35</cim:ACLineSegment.x>
        <cim:ConductingEquipment.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
    </cim:ACLineSegment>

    <!-- ================= TERMINALS ================= -->
    <!-- Generators -->
    <cim:Terminal rdf:ID="T_Gen_A">
        <cim:Terminal.ConductingEquipment rdf:resource="#Gen_A"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Bus_A"/>
    </cim:Terminal>

    <cim:Terminal rdf:ID="T_Gen_B">
        <cim:Terminal.ConductingEquipment rdf:resource="#Gen_B"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Bus_B"/>
    </cim:Terminal>

    <!-- Line -->
    <cim:Terminal rdf:ID="T_Line_A_B_1">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_A_B"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Bus_A"/>
    </cim:Terminal>

    <cim:Terminal rdf:ID="T_Line_A_B_2">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_A_B"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Bus_B"/>
    </cim:Terminal>

</rdf:RDF>
