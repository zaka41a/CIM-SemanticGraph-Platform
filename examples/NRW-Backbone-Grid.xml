<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:cim="http://iec.ch/TC57/CIM100#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <cim:BaseVoltage rdf:ID="BV_380kV"><cim:IdentifiedObject.name>380kV</cim:IdentifiedObject.name></cim:BaseVoltage>
    <cim:BaseVoltage rdf:ID="BV_225kV"><cim:IdentifiedObject.name>225kV</cim:IdentifiedObject.name></cim:BaseVoltage>

    <cim:Substation rdf:ID="Sub_Brauweiler">
        <cim:IdentifiedObject.name>Brauweiler Hub (Amprion)</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Centre de contrôle majeur près de Cologne</cim:IdentifiedObject.description>
    </cim:Substation>

    <cim:Substation rdf:ID="Sub_Dortmund">
        <cim:IdentifiedObject.name>Dortmund West</cim:IdentifiedObject.name>
    </cim:Substation>

    <cim:Substation rdf:ID="Sub_Duisburg">
        <cim:IdentifiedObject.name>Duisburg Steel Zone</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Zone industrielle à haute intensité</cim:IdentifiedObject.description>
    </cim:Substation>

    <cim:Substation rdf:ID="Sub_Paderborn">
        <cim:IdentifiedObject.name>Paderborn Wind Hub</cim:IdentifiedObject.name>
    </cim:Substation>

    <cim:Substation rdf:ID="Sub_Wesel">
        <cim:IdentifiedObject.name>Wesel Interconnector</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Lien vers les Pays-Bas</cim:IdentifiedObject.description>
    </cim:Substation>

    <cim:GeneratingUnit rdf:ID="Gen_Neurath">
        <cim:IdentifiedObject.name>Neurath Power Plant</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Centrale thermique majeure (Lignite/Transition)</cim:IdentifiedObject.description>
        <cim:Equipment.EquipmentContainer rdf:resource="#Sub_Brauweiler"/>
    </cim:GeneratingUnit>

    <cim:GeneratingUnit rdf:ID="Gen_Wind_NRW_East">
        <cim:IdentifiedObject.name>Paderborn Wind Cluster</cim:IdentifiedObject.name>
        <cim:GeneratingUnit.maxOperatingP>800.0</cim:GeneratingUnit.maxOperatingP>
        <cim:Equipment.EquipmentContainer rdf:resource="#Sub_Paderborn"/>
    </cim:GeneratingUnit>

    <cim:ACLineSegment rdf:ID="Line_Wesel_Duisburg">
        <cim:IdentifiedObject.name>Line Wesel-Duisburg</cim:IdentifiedObject.name>
        <cim:ACLineSegment.thermalRating>2500.0</cim:ACLineSegment.thermalRating>
    </cim:ACLineSegment>

    <cim:ACLineSegment rdf:ID="Line_Duisburg_Brauweiler">
        <cim:IdentifiedObject.name>Line Duisburg-Brauweiler</cim:IdentifiedObject.name>
    </cim:ACLineSegment>

    <cim:ACLineSegment rdf:ID="Line_Brauweiler_Dortmund">
        <cim:IdentifiedObject.name>Line Brauweiler-Dortmund</cim:IdentifiedObject.name>
    </cim:ACLineSegment>

    <cim:ACLineSegment rdf:ID="Line_Dortmund_Paderborn">
        <cim:IdentifiedObject.name>Line Dortmund-Paderborn</cim:IdentifiedObject.name>
    </cim:ACLineSegment>

    <cim:ConnectivityNode rdf:ID="Bus_Brauweiler_380">
        <cim:IdentifiedObject.name>Brauweiler Main Busbar</cim:IdentifiedObject.name>
    </cim:ConnectivityNode>

    <cim:Terminal rdf:ID="Term_Neurath_Output">
        <cim:Terminal.ConductingEquipment rdf:resource="#Gen_Neurath"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Bus_Brauweiler_380"/>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Term_Line_Brauweiler_Start">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_Brauweiler_Dortmund"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Bus_Brauweiler_380"/>
    </cim:Terminal>

</rdf:RDF>