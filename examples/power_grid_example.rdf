<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:cim="http://iec.ch/TC57/CIM100#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <!-- Substation 1: Main City Substation -->
    <cim:Substation rdf:about="http://iec.ch/TC57/CIM100#Substation_MainCity">
        <cim:IdentifiedObject.name>Main City Substation</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Primary 400kV/132kV substation serving downtown area</cim:IdentifiedObject.description>
        <cim:Substation.Region rdf:resource="http://iec.ch/TC57/CIM100#Region_Metropolitan"/>
    </cim:Substation>

    <!-- Substation 2: Industrial Zone Substation -->
    <cim:Substation rdf:about="http://iec.ch/TC57/CIM100#Substation_IndustrialZone">
        <cim:IdentifiedObject.name>Industrial Zone Substation</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Secondary 132kV/33kV substation for industrial loads</cim:IdentifiedObject.description>
        <cim:Substation.Region rdf:resource="http://iec.ch/TC57/CIM100#Region_Industrial"/>
    </cim:Substation>

    <!-- Voltage Level 1: 400kV -->
    <cim:VoltageLevel rdf:about="http://iec.ch/TC57/CIM100#VoltageLevel_400kV">
        <cim:IdentifiedObject.name>400kV Level</cim:IdentifiedObject.name>
        <cim:VoltageLevel.BaseVoltage rdf:resource="http://iec.ch/TC57/CIM100#BaseVoltage_400"/>
        <cim:VoltageLevel.Substation rdf:resource="http://iec.ch/TC57/CIM100#Substation_MainCity"/>
        <cim:VoltageLevel.highVoltageLimit rdf:datatype="http://www.w3.org/2001/XMLSchema#double">420.0</cim:VoltageLevel.highVoltageLimit>
        <cim:VoltageLevel.lowVoltageLimit rdf:datatype="http://www.w3.org/2001/XMLSchema#double">380.0</cim:VoltageLevel.lowVoltageLimit>
    </cim:VoltageLevel>

    <!-- Voltage Level 2: 132kV -->
    <cim:VoltageLevel rdf:about="http://iec.ch/TC57/CIM100#VoltageLevel_132kV">
        <cim:IdentifiedObject.name>132kV Level</cim:IdentifiedObject.name>
        <cim:VoltageLevel.BaseVoltage rdf:resource="http://iec.ch/TC57/CIM100#BaseVoltage_132"/>
        <cim:VoltageLevel.Substation rdf:resource="http://iec.ch/TC57/CIM100#Substation_MainCity"/>
        <cim:VoltageLevel.highVoltageLimit rdf:datatype="http://www.w3.org/2001/XMLSchema#double">145.0</cim:VoltageLevel.highVoltageLimit>
        <cim:VoltageLevel.lowVoltageLimit rdf:datatype="http://www.w3.org/2001/XMLSchema#double">120.0</cim:VoltageLevel.lowVoltageLimit>
    </cim:VoltageLevel>

    <!-- Generating Unit: Coal Power Plant -->
    <cim:GeneratingUnit rdf:about="http://iec.ch/TC57/CIM100#GeneratingUnit_CoalPlant1">
        <cim:IdentifiedObject.name>Coal Power Plant Unit 1</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>500MW coal-fired generating unit</cim:IdentifiedObject.description>
        <cim:GeneratingUnit.genControlSource rdf:resource="http://iec.ch/TC57/CIM100#GeneratorControlSource.plantControl"/>
        <cim:GeneratingUnit.maxOperatingP rdf:datatype="http://www.w3.org/2001/XMLSchema#double">500.0</cim:GeneratingUnit.maxOperatingP>
        <cim:GeneratingUnit.minOperatingP rdf:datatype="http://www.w3.org/2001/XMLSchema#double">100.0</cim:GeneratingUnit.minOperatingP>
        <cim:GeneratingUnit.nominalP rdf:datatype="http://www.w3.org/2001/XMLSchema#double">500.0</cim:GeneratingUnit.nominalP>
    </cim:GeneratingUnit>

    <!-- Generating Unit: Wind Farm -->
    <cim:GeneratingUnit rdf:about="http://iec.ch/TC57/CIM100#GeneratingUnit_WindFarm1">
        <cim:IdentifiedObject.name>Offshore Wind Farm</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>200MW offshore wind generation facility</cim:IdentifiedObject.description>
        <cim:GeneratingUnit.genControlSource rdf:resource="http://iec.ch/TC57/CIM100#GeneratorControlSource.plantControl"/>
        <cim:GeneratingUnit.maxOperatingP rdf:datatype="http://www.w3.org/2001/XMLSchema#double">200.0</cim:GeneratingUnit.maxOperatingP>
        <cim:GeneratingUnit.minOperatingP rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</cim:GeneratingUnit.minOperatingP>
        <cim:GeneratingUnit.nominalP rdf:datatype="http://www.w3.org/2001/XMLSchema#double">200.0</cim:GeneratingUnit.nominalP>
    </cim:GeneratingUnit>

    <!-- Synchronous Machine: Generator at Coal Plant -->
    <cim:SynchronousMachine rdf:about="http://iec.ch/TC57/CIM100#SynchMachine_CoalGen1">
        <cim:IdentifiedObject.name>Coal Generator 1</cim:IdentifiedObject.name>
        <cim:SynchronousMachine.GeneratingUnit rdf:resource="http://iec.ch/TC57/CIM100#GeneratingUnit_CoalPlant1"/>
        <cim:SynchronousMachine.ratedPowerFactor rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.85</cim:SynchronousMachine.ratedPowerFactor>
        <cim:SynchronousMachine.ratedS rdf:datatype="http://www.w3.org/2001/XMLSchema#double">588.24</cim:SynchronousMachine.ratedS>
        <cim:SynchronousMachine.type rdf:resource="http://iec.ch/TC57/CIM100#SynchronousMachineKind.generator"/>
    </cim:SynchronousMachine>

    <!-- AC Line Segment: Transmission Line -->
    <cim:ACLineSegment rdf:about="http://iec.ch/TC57/CIM100#Line_MainCity_Industrial">
        <cim:IdentifiedObject.name>Main City - Industrial Zone Line</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>400kV transmission line connecting substations</cim:IdentifiedObject.description>
        <cim:ACLineSegment.r rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.05</cim:ACLineSegment.r>
        <cim:ACLineSegment.x rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.15</cim:ACLineSegment.x>
        <cim:ACLineSegment.bch rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0001</cim:ACLineSegment.bch>
        <cim:Conductor.length rdf:datatype="http://www.w3.org/2001/XMLSchema#double">45.5</cim:Conductor.length>
    </cim:ACLineSegment>

    <!-- Power Transformer: 400/132kV -->
    <cim:PowerTransformer rdf:about="http://iec.ch/TC57/CIM100#Transformer_T1">
        <cim:IdentifiedObject.name>Main Transformer T1</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>400/132kV 300MVA power transformer</cim:IdentifiedObject.description>
        <cim:PowerTransformer.Substation rdf:resource="http://iec.ch/TC57/CIM100#Substation_MainCity"/>
    </cim:PowerTransformer>

    <!-- Power Transformer End: High Voltage Side -->
    <cim:PowerTransformerEnd rdf:about="http://iec.ch/TC57/CIM100#TransformerEnd_T1_HV">
        <cim:IdentifiedObject.name>T1 High Voltage Winding</cim:IdentifiedObject.name>
        <cim:PowerTransformerEnd.PowerTransformer rdf:resource="http://iec.ch/TC57/CIM100#Transformer_T1"/>
        <cim:PowerTransformerEnd.ratedS rdf:datatype="http://www.w3.org/2001/XMLSchema#double">300.0</cim:PowerTransformerEnd.ratedS>
        <cim:PowerTransformerEnd.ratedU rdf:datatype="http://www.w3.org/2001/XMLSchema#double">400.0</cim:PowerTransformerEnd.ratedU>
        <cim:TransformerEnd.endNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cim:TransformerEnd.endNumber>
    </cim:PowerTransformerEnd>

    <!-- Power Transformer End: Low Voltage Side -->
    <cim:PowerTransformerEnd rdf:about="http://iec.ch/TC57/CIM100#TransformerEnd_T1_LV">
        <cim:IdentifiedObject.name>T1 Low Voltage Winding</cim:IdentifiedObject.name>
        <cim:PowerTransformerEnd.PowerTransformer rdf:resource="http://iec.ch/TC57/CIM100#Transformer_T1"/>
        <cim:PowerTransformerEnd.ratedS rdf:datatype="http://www.w3.org/2001/XMLSchema#double">300.0</cim:PowerTransformerEnd.ratedS>
        <cim:PowerTransformerEnd.ratedU rdf:datatype="http://www.w3.org/2001/XMLSchema#double">132.0</cim:PowerTransformerEnd.ratedU>
        <cim:TransformerEnd.endNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cim:TransformerEnd.endNumber>
    </cim:PowerTransformerEnd>

    <!-- Breaker: Circuit Breaker -->
    <cim:Breaker rdf:about="http://iec.ch/TC57/CIM100#Breaker_CB1">
        <cim:IdentifiedObject.name>Circuit Breaker CB1</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>400kV circuit breaker for line protection</cim:IdentifiedObject.description>
        <cim:Breaker.ratedCurrent rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2000.0</cim:Breaker.ratedCurrent>
        <cim:Switch.normalOpen rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</cim:Switch.normalOpen>
    </cim:Breaker>

    <!-- Energy Consumer: Industrial Load -->
    <cim:EnergyConsumer rdf:about="http://iec.ch/TC57/CIM100#Load_Industrial1">
        <cim:IdentifiedObject.name>Industrial Load 1</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Large industrial manufacturing facility</cim:IdentifiedObject.description>
        <cim:EnergyConsumer.p rdf:datatype="http://www.w3.org/2001/XMLSchema#double">150.0</cim:EnergyConsumer.p>
        <cim:EnergyConsumer.q rdf:datatype="http://www.w3.org/2001/XMLSchema#double">75.0</cim:EnergyConsumer.q>
        <cim:EnergyConsumer.pfixed rdf:datatype="http://www.w3.org/2001/XMLSchema#double">150.0</cim:EnergyConsumer.pfixed>
        <cim:EnergyConsumer.qfixed rdf:datatype="http://www.w3.org/2001/XMLSchema#double">75.0</cim:EnergyConsumer.qfixed>
    </cim:EnergyConsumer>

    <!-- Connectivity Node -->
    <cim:ConnectivityNode rdf:about="http://iec.ch/TC57/CIM100#ConnNode_400kV_Bus1">
        <cim:IdentifiedObject.name>400kV Bus 1</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Main 400kV busbar</cim:IdentifiedObject.description>
        <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="http://iec.ch/TC57/CIM100#VoltageLevel_400kV"/>
    </cim:ConnectivityNode>

    <!-- Base Voltage Definitions -->
    <cim:BaseVoltage rdf:about="http://iec.ch/TC57/CIM100#BaseVoltage_400">
        <cim:IdentifiedObject.name>400 kV</cim:IdentifiedObject.name>
        <cim:BaseVoltage.nominalVoltage rdf:datatype="http://www.w3.org/2001/XMLSchema#double">400.0</cim:BaseVoltage.nominalVoltage>
    </cim:BaseVoltage>

    <cim:BaseVoltage rdf:about="http://iec.ch/TC57/CIM100#BaseVoltage_132">
        <cim:IdentifiedObject.name>132 kV</cim:IdentifiedObject.name>
        <cim:BaseVoltage.nominalVoltage rdf:datatype="http://www.w3.org/2001/XMLSchema#double">132.0</cim:BaseVoltage.nominalVoltage>
    </cim:BaseVoltage>

    <!-- Geographic Regions -->
    <cim:GeographicalRegion rdf:about="http://iec.ch/TC57/CIM100#Region_Metropolitan">
        <cim:IdentifiedObject.name>Metropolitan Region</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Urban metropolitan area</cim:IdentifiedObject.description>
    </cim:GeographicalRegion>

    <cim:GeographicalRegion rdf:about="http://iec.ch/TC57/CIM100#Region_Industrial">
        <cim:IdentifiedObject.name>Industrial Region</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Heavy industrial zone</cim:IdentifiedObject.description>
    </cim:GeographicalRegion>

</rdf:RDF>
