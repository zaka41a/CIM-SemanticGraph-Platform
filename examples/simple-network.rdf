<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:cim="http://iec.ch/TC57/CIM100#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <!-- Base Voltages -->
    <cim:BaseVoltage rdf:ID="BV_220kV">
        <cim:IdentifiedObject.name>220kV</cim:IdentifiedObject.name>
        <cim:BaseVoltage.nominalVoltage>220.0</cim:BaseVoltage.nominalVoltage>
    </cim:BaseVoltage>

    <cim:BaseVoltage rdf:ID="BV_110kV">
        <cim:IdentifiedObject.name>110kV</cim:IdentifiedObject.name>
        <cim:BaseVoltage.nominalVoltage>110.0</cim:BaseVoltage.nominalVoltage>
    </cim:BaseVoltage>

    <!-- Substations -->
    <cim:Substation rdf:ID="Sub_Central">
        <cim:IdentifiedObject.name>Central Substation</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Main distribution hub</cim:IdentifiedObject.description>
    </cim:Substation>

    <cim:Substation rdf:ID="Sub_North">
        <cim:IdentifiedObject.name>North Substation</cim:IdentifiedObject.name>
    </cim:Substation>

    <cim:Substation rdf:ID="Sub_South">
        <cim:IdentifiedObject.name>South Substation</cim:IdentifiedObject.name>
    </cim:Substation>

    <!-- Voltage Levels -->
    <cim:VoltageLevel rdf:ID="VL_Central_220">
        <cim:IdentifiedObject.name>Central 220kV</cim:IdentifiedObject.name>
        <cim:VoltageLevel.Substation rdf:resource="#Sub_Central"/>
        <cim:VoltageLevel.BaseVoltage rdf:resource="#BV_220kV"/>
    </cim:VoltageLevel>

    <cim:VoltageLevel rdf:ID="VL_North_220">
        <cim:IdentifiedObject.name>North 220kV</cim:IdentifiedObject.name>
        <cim:VoltageLevel.Substation rdf:resource="#Sub_North"/>
        <cim:VoltageLevel.BaseVoltage rdf:resource="#BV_220kV"/>
    </cim:VoltageLevel>

    <cim:VoltageLevel rdf:ID="VL_South_220">
        <cim:IdentifiedObject.name>South 220kV</cim:IdentifiedObject.name>
        <cim:VoltageLevel.Substation rdf:resource="#Sub_South"/>
        <cim:VoltageLevel.BaseVoltage rdf:resource="#BV_220kV"/>
    </cim:VoltageLevel>

    <!-- Connectivity Nodes (Buses) -->
    <cim:ConnectivityNode rdf:ID="CN_Central_220">
        <cim:IdentifiedObject.name>Central 220kV Bus</cim:IdentifiedObject.name>
        <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="#VL_Central_220"/>
    </cim:ConnectivityNode>

    <cim:ConnectivityNode rdf:ID="CN_North_220">
        <cim:IdentifiedObject.name>North 220kV Bus</cim:IdentifiedObject.name>
        <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="#VL_North_220"/>
    </cim:ConnectivityNode>

    <cim:ConnectivityNode rdf:ID="CN_South_220">
        <cim:IdentifiedObject.name>South 220kV Bus</cim:IdentifiedObject.name>
        <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="#VL_South_220"/>
    </cim:ConnectivityNode>

    <!-- Generators -->
    <cim:GeneratingUnit rdf:ID="Gen_Central_1">
        <cim:IdentifiedObject.name>Central Generator 1</cim:IdentifiedObject.name>
        <cim:GeneratingUnit.maxOperatingP>300.0</cim:GeneratingUnit.maxOperatingP>
        <cim:GeneratingUnit.minOperatingP>0.0</cim:GeneratingUnit.minOperatingP>
        <cim:Equipment.EquipmentContainer rdf:resource="#Sub_Central"/>
    </cim:GeneratingUnit>

    <cim:SynchronousMachine rdf:ID="SM_Central_1">
        <cim:IdentifiedObject.name>Central Synchronous Machine 1</cim:IdentifiedObject.name>
        <cim:RotatingMachine.GeneratingUnit rdf:resource="#Gen_Central_1"/>
        <cim:SynchronousMachine.maxQ>150.0</cim:SynchronousMachine.maxQ>
        <cim:SynchronousMachine.minQ>-150.0</cim:SynchronousMachine.minQ>
    </cim:SynchronousMachine>

    <!-- Loads -->
    <cim:EnergyConsumer rdf:ID="Load_North">
        <cim:IdentifiedObject.name>North Load</cim:IdentifiedObject.name>
        <cim:EnergyConsumer.p>200.0</cim:EnergyConsumer.p>
        <cim:EnergyConsumer.q>80.0</cim:EnergyConsumer.q>
        <cim:Equipment.EquipmentContainer rdf:resource="#Sub_North"/>
    </cim:EnergyConsumer>

    <cim:EnergyConsumer rdf:ID="Load_South">
        <cim:IdentifiedObject.name>South Load</cim:IdentifiedObject.name>
        <cim:EnergyConsumer.p>250.0</cim:EnergyConsumer.p>
        <cim:EnergyConsumer.q>100.0</cim:EnergyConsumer.q>
        <cim:Equipment.EquipmentContainer rdf:resource="#Sub_South"/>
    </cim:EnergyConsumer>

    <!-- Transmission Lines -->
    <cim:ACLineSegment rdf:ID="Line_Central_North">
        <cim:IdentifiedObject.name>Central-North Line</cim:IdentifiedObject.name>
        <cim:Conductor.length>85.0</cim:Conductor.length>
        <cim:ACLineSegment.r>0.01</cim:ACLineSegment.r>
        <cim:ACLineSegment.x>0.10</cim:ACLineSegment.x>
        <cim:ACLineSegment.bch>0.002</cim:ACLineSegment.bch>
        <cim:ACLineSegment.thermalRating>1000.0</cim:ACLineSegment.thermalRating>
    </cim:ACLineSegment>

    <cim:ACLineSegment rdf:ID="Line_Central_South">
        <cim:IdentifiedObject.name>Central-South Line</cim:IdentifiedObject.name>
        <cim:Conductor.length>120.0</cim:Conductor.length>
        <cim:ACLineSegment.r>0.012</cim:ACLineSegment.r>
        <cim:ACLineSegment.x>0.12</cim:ACLineSegment.x>
        <cim:ACLineSegment.bch>0.0025</cim:ACLineSegment.bch>
        <cim:ACLineSegment.thermalRating>1000.0</cim:ACLineSegment.thermalRating>
    </cim:ACLineSegment>

    <cim:ACLineSegment rdf:ID="Line_North_South">
        <cim:IdentifiedObject.name>North-South Line</cim:IdentifiedObject.name>
        <cim:Conductor.length>95.0</cim:Conductor.length>
        <cim:ACLineSegment.r>0.011</cim:ACLineSegment.r>
        <cim:ACLineSegment.x>0.11</cim:ACLineSegment.x>
        <cim:ACLineSegment.bch>0.002</cim:ACLineSegment.bch>
        <cim:ACLineSegment.thermalRating>800.0</cim:ACLineSegment.thermalRating>
    </cim:ACLineSegment>

    <!-- Terminals for Generator -->
    <cim:Terminal rdf:ID="Term_Gen_Central_1">
        <cim:Terminal.ConductingEquipment rdf:resource="#SM_Central_1"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#CN_Central_220"/>
        <cim:Terminal.sequenceNumber>1</cim:Terminal.sequenceNumber>
    </cim:Terminal>

    <!-- Terminals for Loads -->
    <cim:Terminal rdf:ID="Term_Load_North">
        <cim:Terminal.ConductingEquipment rdf:resource="#Load_North"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#CN_North_220"/>
        <cim:Terminal.sequenceNumber>1</cim:Terminal.sequenceNumber>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Term_Load_South">
        <cim:Terminal.ConductingEquipment rdf:resource="#Load_South"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#CN_South_220"/>
        <cim:Terminal.sequenceNumber>1</cim:Terminal.sequenceNumber>
    </cim:Terminal>

    <!-- Terminals for Lines -->
    <cim:Terminal rdf:ID="Term_Line_CN_1">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_Central_North"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#CN_Central_220"/>
        <cim:Terminal.sequenceNumber>1</cim:Terminal.sequenceNumber>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Term_Line_CN_2">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_Central_North"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#CN_North_220"/>
        <cim:Terminal.sequenceNumber>2</cim:Terminal.sequenceNumber>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Term_Line_CS_1">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_Central_South"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#CN_Central_220"/>
        <cim:Terminal.sequenceNumber>1</cim:Terminal.sequenceNumber>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Term_Line_CS_2">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_Central_South"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#CN_South_220"/>
        <cim:Terminal.sequenceNumber>2</cim:Terminal.sequenceNumber>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Term_Line_NS_1">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_North_South"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#CN_North_220"/>
        <cim:Terminal.sequenceNumber>1</cim:Terminal.sequenceNumber>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Term_Line_NS_2">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_North_South"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#CN_South_220"/>
        <cim:Terminal.sequenceNumber>2</cim:Terminal.sequenceNumber>
    </cim:Terminal>

</rdf:RDF>
