    <cim:ACLineSegment rdf:ID="L_W1_W2"><cim:IdentifiedObject.name>Dorsale_Ouest</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_W1_C1"><cim:IdentifiedObject.name>Ligne_Ouest_Centre</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_W2_S1"><cim:IdentifiedObject.name>Ligne_Ouest_Sud</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_S1_S2"><cim:IdentifiedObject.name>Dorsale_Sud</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_S1_C2"><cim:IdentifiedObject.name>Ligne_Sud_Centre</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_C1_C2"><cim:IdentifiedObject.name>Lien_Hub_Central</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_C1_CityA"><cim:IdentifiedObject.name>Alim_Metropole_A</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_C2_CityB"><cim:IdentifiedObject.name>Alim_Metropole_B</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_CityA_Indus1"><cim:IdentifiedObject.name>Lien_Industrie_A</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_CityB_Indus2"><cim:IdentifiedObject.name>Lien_Industrie_B</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_N2_Inter"><cim:IdentifiedObject.name>Export_Nord</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_S2_Inter"><cim:IdentifiedObject.name>Export_Sud</cim:IdentifiedObject.name></cim:ACLineSegment>
