    <cim:Substation rdf:ID="Sub_W2"><cim:IdentifiedObject.name>Ouest_Poste_2</cim:IdentifiedObject.name></cim:Substation>
    <cim:Substation rdf:ID="Sub_S1"><cim:IdentifiedObject.name>Sud_Poste_1</cim:IdentifiedObject.name></cim:Substation>
    <cim:Substation rdf:ID="Sub_S2"><cim:IdentifiedObject.name>Sud_Poste_2</cim:IdentifiedObject.name></cim:Substation>
    <cim:Substation rdf:ID="Sub_C1"><cim:IdentifiedObject.name>Centre_Hub_1</cim:IdentifiedObject.name></cim:Substation>
    <cim:Substation rdf:ID="Sub_C2"><cim:IdentifiedObject.name>Centre_Hub_2</cim:IdentifiedObject.name></cim:Substation>
    <cim:Substation rdf:ID="Sub_Indus_1"><cim:IdentifiedObject.name>Zone_Indus_A</cim:IdentifiedObject.name></cim:Substation>
    <cim:Substation rdf:ID="Sub_Indus_2"><cim:IdentifiedObject.name>Zone_Indus_B</cim:IdentifiedObject.name></cim:Substation>
    <cim:Substation rdf:ID="Sub_City_A"><cim:IdentifiedObject.name>Metropole_A</cim:IdentifiedObject.name></cim:Substation>
    <cim:Substation rdf:ID="Sub_City_B"><cim:IdentifiedObject.name>Metropole_B</cim:IdentifiedObject.name></cim:Substation>
    <cim:Substation rdf:ID="Sub_Inter_Border"><cim:IdentifiedObject.name>Interconnexion_Frontiere</cim:IdentifiedObject.name></cim:Substation>

    <cim:GeneratingUnit rdf:ID="Gen_Nuclear_1"><cim:IdentifiedObject.name>Centrale_Nucleaire_Nord</cim:IdentifiedObject.name><cim:Equipment.EquipmentContainer rdf:resource="#Sub_N1"/></cim:GeneratingUnit>
    <cim:GeneratingUnit rdf:ID="Gen_Wind_Offshore"><cim:IdentifiedObject.name>Parc_Eolien_Mer</cim:IdentifiedObject.name><cim:Equipment.EquipmentContainer rdf:resource="#Sub_W1"/></cim:GeneratingUnit>
    <cim:GeneratingUnit rdf:ID="Gen_Solar_Large"><cim:IdentifiedObject.name>Ferme_Solaire_Sud</cim:IdentifiedObject.name><cim:Equipment.EquipmentContainer rdf:resource="#Sub_S2"/></cim:GeneratingUnit>
    <cim:GeneratingUnit rdf:ID="Gen_Gas_Peak"><cim:IdentifiedObject.name>Turbine_Gaz_Centre</cim:IdentifiedObject.name><cim:Equipment.EquipmentContainer rdf:resource="#Sub_C1"/></cim:GeneratingUnit>
    <cim:GeneratingUnit rdf:ID="Gen_Hydro_1"><cim:IdentifiedObject.name>Barrage_Est</cim:IdentifiedObject.name><cim:Equipment.EquipmentContainer rdf:resource="#Sub_E1"/></cim:GeneratingUnit>
    <cim:GeneratingUnit rdf:ID="Gen_Nuclear_2"><cim:IdentifiedObject.name>Centrale_Nucleaire_Sud</cim:IdentifiedObject.name><cim:Equipment.EquipmentContainer rdf:resource="#Sub_S1"/></cim:GeneratingUnit>
    <cim:GeneratingUnit rdf:ID="Gen_Wind_Land"><cim:IdentifiedObject.name>Eolien_Terrestre_W</cim:IdentifiedObject.name><cim:Equipment.EquipmentContainer rdf:resource="#Sub_W2"/></cim:GeneratingUnit>
    <cim:GeneratingUnit rdf:ID="Gen_Bio_1"><cim:IdentifiedObject.name>Biomasse_Centre</cim:IdentifiedObject.name><cim:Equipment.EquipmentContainer rdf:resource="#Sub_C2"/></cim:GeneratingUnit>

    <cim:ACLineSegment rdf:ID="L_N1_N2"><cim:IdentifiedObject.name>Line_Nord_Inter</cim:IdentifiedObject.name></cim:ACLineSegment>
