    <cim:ACLineSegment rdf:ID="L_W2_Indus2"><cim:IdentifiedObject.name>Secours_Ouest_Indus</cim:IdentifiedObject.name></cim:ACLineSegment>
    <cim:ACLineSegment rdf:ID="L_C1_S2"><cim:IdentifiedObject.name>Lien_Direct_C_S</cim:IdentifiedObject.name></cim:ACLineSegment>

    <cim:EnergyConsumer rdf:ID="Load_CityA"><cim:IdentifiedObject.name>Consommation_Ville_A</cim:IdentifiedObject.name><cim:Equipment.EquipmentContainer rdf:resource="#Sub_City_A"/></cim:EnergyConsumer>
    <cim:EnergyConsumer rdf:ID="Load_IndusB"><cim:IdentifiedObject.name>Consommation_Usine_B</cim:IdentifiedObject.name><cim:Equipment.EquipmentContainer rdf:resource="#Sub_Indus_2"/></cim:EnergyConsumer>

    <cim:ConnectivityNode rdf:ID="Node_N1"><cim:IdentifiedObject.name>Node_Nord_1</cim:IdentifiedObject.name></cim:ConnectivityNode>
    <cim:ConnectivityNode rdf:ID="Node_C1"><cim:IdentifiedObject.name>Node_Centre_1</cim:IdentifiedObject.name></cim:ConnectivityNode>

    <cim:Terminal rdf:ID="Term_Gen_N1">
        <cim:Terminal.ConductingEquipment rdf:resource="#Gen_Nuclear_1"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Node_N1"/>
    </cim:Terminal>
    <cim:Terminal rdf:ID="Term_Line_N1">
        <cim:Terminal.ConductingEquipment rdf:resource="#L_N1_C1"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Node_N1"/>
    </cim:Terminal>
    <cim:Terminal rdf:ID="Term_Line_C1">
        <cim:Terminal.ConductingEquipment rdf:resource="#L_N1_C1"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Node_C1"/>
    </cim:Terminal>

</rdf:RDF>