<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:cim="http://iec.ch/TC57/CIM100#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

<!-- ================= BASE VOLTAGES ================= -->

<cim:BaseVoltage rdf:ID="BaseVoltage_220kV">
    <cim:IdentifiedObject.name>220kV</cim:IdentifiedObject.name>
    <cim:BaseVoltage.nominalVoltage>220000</cim:BaseVoltage.nominalVoltage>
</cim:BaseVoltage>

<cim:BaseVoltage rdf:ID="BaseVoltage_110kV">
    <cim:IdentifiedObject.name>110kV</cim:IdentifiedObject.name>
    <cim:BaseVoltage.nominalVoltage>110000</cim:BaseVoltage.nominalVoltage>
</cim:BaseVoltage>

<!-- ================= REGIONS ================= -->

<cim:SubGeographicalRegion rdf:ID="Region_North">
    <cim:IdentifiedObject.name>Northern Region</cim:IdentifiedObject.name>
</cim:SubGeographicalRegion>

<cim:SubGeographicalRegion rdf:ID="Region_Central">
    <cim:IdentifiedObject.name>Central Region</cim:IdentifiedObject.name>
</cim:SubGeographicalRegion>

<cim:SubGeographicalRegion rdf:ID="Region_South">
    <cim:IdentifiedObject.name>Southern Region</cim:IdentifiedObject.name>
</cim:SubGeographicalRegion>

<!-- ================= SUBSTATIONS ================= -->

<cim:Substation rdf:ID="Substation_North_Main">
    <cim:IdentifiedObject.name>North Main Substation</cim:IdentifiedObject.name>
    <cim:Substation.Region rdf:resource="#Region_North"/>
</cim:Substation>

<cim:Substation rdf:ID="Substation_Central_Distribution">
    <cim:IdentifiedObject.name>Central Distribution Substation</cim:IdentifiedObject.name>
    <cim:Substation.Region rdf:resource="#Region_Central"/>
</cim:Substation>

<cim:Substation rdf:ID="Substation_South_Industrial">
    <cim:IdentifiedObject.name>South Industrial Substation</cim:IdentifiedObject.name>
    <cim:Substation.Region rdf:resource="#Region_South"/>
</cim:Substation>

<!-- ================= VOLTAGE LEVELS ================= -->

<cim:VoltageLevel rdf:ID="VoltageLevel_220kV_North">
    <cim:IdentifiedObject.name>220kV North</cim:IdentifiedObject.name>
    <cim:VoltageLevel.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
    <cim:VoltageLevel.Substation rdf:resource="#Substation_North_Main"/>
</cim:VoltageLevel>

<cim:VoltageLevel rdf:ID="VoltageLevel_110kV_Central">
    <cim:IdentifiedObject.name>110kV Central</cim:IdentifiedObject.name>
    <cim:VoltageLevel.BaseVoltage rdf:resource="#BaseVoltage_110kV"/>
    <cim:VoltageLevel.Substation rdf:resource="#Substation_Central_Distribution"/>
</cim:VoltageLevel>

<cim:VoltageLevel rdf:ID="VoltageLevel_220kV_Central">
    <cim:IdentifiedObject.name>220kV Central</cim:IdentifiedObject.name>
    <cim:VoltageLevel.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
    <cim:VoltageLevel.Substation rdf:resource="#Substation_Central_Distribution"/>
</cim:VoltageLevel>

<cim:VoltageLevel rdf:ID="VoltageLevel_220kV_South">
    <cim:IdentifiedObject.name>220kV South</cim:IdentifiedObject.name>
    <cim:VoltageLevel.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
    <cim:VoltageLevel.Substation rdf:resource="#Substation_South_Industrial"/>
</cim:VoltageLevel>

<!-- ================= CONNECTIVITY NODES ================= -->

<cim:ConnectivityNode rdf:ID="Node_North_220kV_Bus">
    <cim:IdentifiedObject.name>North 220kV Bus</cim:IdentifiedObject.name>
    <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="#VoltageLevel_220kV_North"/>
</cim:ConnectivityNode>

<cim:ConnectivityNode rdf:ID="Node_Central_110kV_Bus">
    <cim:IdentifiedObject.name>Central 110kV Bus</cim:IdentifiedObject.name>
    <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="#VoltageLevel_110kV_Central"/>
</cim:ConnectivityNode>

<cim:ConnectivityNode rdf:ID="Node_Central_220kV_Bus">
    <cim:IdentifiedObject.name>Central 220kV Bus</cim:IdentifiedObject.name>
    <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="#VoltageLevel_220kV_Central"/>
</cim:ConnectivityNode>

<cim:ConnectivityNode rdf:ID="Node_South_220kV_Bus">
    <cim:IdentifiedObject.name>South 220kV Bus</cim:IdentifiedObject.name>
    <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="#VoltageLevel_220kV_South"/>
</cim:ConnectivityNode>

<!-- ================= GENERATORS ================= -->

<cim:GeneratingUnit rdf:ID="Generator_North_1">
    <cim:IdentifiedObject.name>North Wind Generator</cim:IdentifiedObject.name>
    <cim:GeneratingUnit.maxOperatingP>50</cim:GeneratingUnit.maxOperatingP>
    <cim:Equipment.EquipmentContainer rdf:resource="#Substation_North_Main"/>
</cim:GeneratingUnit>

<cim:GeneratingUnit rdf:ID="Generator_South_1">
    <cim:IdentifiedObject.name>South Gas Generator</cim:IdentifiedObject.name>
    <cim:GeneratingUnit.maxOperatingP>150</cim:GeneratingUnit.maxOperatingP>
    <cim:Equipment.EquipmentContainer rdf:resource="#Substation_South_Industrial"/>
</cim:GeneratingUnit>

<!-- ================= AC LINE SEGMENTS ================= -->

<cim:ACLineSegment rdf:ID="Line_North_Central">
    <cim:IdentifiedObject.name>North-Central 220kV</cim:IdentifiedObject.name>
    <cim:Conductor.length>45.5</cim:Conductor.length>
    <cim:ACLineSegment.r>0.15</cim:ACLineSegment.r>
    <cim:ACLineSegment.x>0.45</cim:ACLineSegment.x>
    <cim:ConductingEquipment.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
</cim:ACLineSegment>

<cim:ACLineSegment rdf:ID="Line_North_Central_Parallel_1">
    <cim:IdentifiedObject.name>North-Central Parallel 1</cim:IdentifiedObject.name>
    <cim:Conductor.length>46</cim:Conductor.length>
    <cim:ACLineSegment.r>0.14</cim:ACLineSegment.r>
    <cim:ACLineSegment.x>0.42</cim:ACLineSegment.x>
    <cim:ConductingEquipment.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
</cim:ACLineSegment>

<cim:ACLineSegment rdf:ID="Line_North_Central_Parallel_2">
    <cim:IdentifiedObject.name>North-Central Parallel 2</cim:IdentifiedObject.name>
    <cim:Conductor.length>46</cim:Conductor.length>
    <cim:ACLineSegment.r>0.16</cim:ACLineSegment.r>
    <cim:ACLineSegment.x>0.48</cim:ACLineSegment.x>
    <cim:ConductingEquipment.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
</cim:ACLineSegment>

<cim:ACLineSegment rdf:ID="Line_Central_South">
    <cim:IdentifiedObject.name>Central-South 220kV</cim:IdentifiedObject.name>
    <cim:Conductor.length>32.8</cim:Conductor.length>
    <cim:ACLineSegment.r>0.12</cim:ACLineSegment.r>
    <cim:ACLineSegment.x>0.38</cim:ACLineSegment.x>
    <cim:ConductingEquipment.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
</cim:ACLineSegment>

<cim:ACLineSegment rdf:ID="Line_Central_South_Parallel">
    <cim:IdentifiedObject.name>Central-South Parallel</cim:IdentifiedObject.name>
    <cim:Conductor.length>33</cim:Conductor.length>
    <cim:ACLineSegment.r>0.11</cim:ACLineSegment.r>
    <cim:ACLineSegment.x>0.36</cim:ACLineSegment.x>
    <cim:ConductingEquipment.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
</cim:ACLineSegment>

<cim:ACLineSegment rdf:ID="Line_North_South_Backup">
    <cim:IdentifiedObject.name>North-South Backup</cim:IdentifiedObject.name>
    <cim:Conductor.length>78.3</cim:Conductor.length>
    <cim:ACLineSegment.r>0.18</cim:ACLineSegment.r>
    <cim:ACLineSegment.x>0.52</cim:ACLineSegment.x>
    <cim:ConductingEquipment.BaseVoltage rdf:resource="#BaseVoltage_220kV"/>
</cim:ACLineSegment>

<!-- ================= TERMINALS ================= -->

<!-- Generators -->
<cim:Terminal rdf:ID="T_Gen_North">
    <cim:Terminal.ConductingEquipment rdf:resource="#Generator_North_1"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_North_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Gen_South">
    <cim:Terminal.ConductingEquipment rdf:resource="#Generator_South_1"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_South_220kV_Bus"/>
</cim:Terminal>

<!-- Lines -->
<cim:Terminal rdf:ID="T_Line_NC_1">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_North_Central"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_North_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_NC_2">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_North_Central"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_Central_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_NC_P1_1">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_North_Central_Parallel_1"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_North_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_NC_P1_2">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_North_Central_Parallel_1"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_Central_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_NC_P2_1">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_North_Central_Parallel_2"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_North_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_NC_P2_2">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_North_Central_Parallel_2"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_Central_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_CS_1">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_Central_South"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_Central_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_CS_2">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_Central_South"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_South_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_CS_P1">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_Central_South_Parallel"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_Central_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_CS_P2">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_Central_South_Parallel"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_South_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_NS_1">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_North_South_Backup"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_North_220kV_Bus"/>
</cim:Terminal>

<cim:Terminal rdf:ID="T_Line_NS_2">
    <cim:Terminal.ConductingEquipment rdf:resource="#Line_North_South_Backup"/>
    <cim:Terminal.ConnectivityNode rdf:resource="#Node_South_220kV_Bus"/>
</cim:Terminal>

</rdf:RDF>
