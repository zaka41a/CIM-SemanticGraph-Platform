<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:cim="http://iec.ch/TC57/CIM100#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <!-- ===== REGION ===== -->
    <cim:SubGeographicalRegion rdf:ID="Region_East">
        <cim:IdentifiedObject.name>Eastern Region</cim:IdentifiedObject.name>
    </cim:SubGeographicalRegion>

    <!-- ===== SUBSTATION ===== -->
    <cim:Substation rdf:ID="Substation_East">
        <cim:IdentifiedObject.name>East Renewable Substation</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>New 110kV renewable hub</cim:IdentifiedObject.description>
        <cim:Substation.Region rdf:resource="#Region_East"/>
    </cim:Substation>

    <!-- ===== BASE VOLTAGE ===== -->
    <cim:BaseVoltage rdf:ID="BaseVoltage_110kV">
        <cim:IdentifiedObject.name>110kV</cim:IdentifiedObject.name>
        <cim:BaseVoltage.nominalVoltage>110000</cim:BaseVoltage.nominalVoltage>
    </cim:BaseVoltage>

    <!-- ===== VOLTAGE LEVEL ===== -->
    <cim:VoltageLevel rdf:ID="VoltageLevel_110kV_East">
        <cim:IdentifiedObject.name>110kV East Level</cim:IdentifiedObject.name>
        <cim:VoltageLevel.BaseVoltage rdf:resource="#BaseVoltage_110kV"/>
        <cim:VoltageLevel.Substation rdf:resource="#Substation_East"/>
    </cim:VoltageLevel>

    <!-- ===== CONNECTIVITY NODE ===== -->
    <cim:ConnectivityNode rdf:ID="Node_East_110kV_Bus">
        <cim:IdentifiedObject.name>East 110kV Bus</cim:IdentifiedObject.name>
        <cim:ConnectivityNode.ConnectivityNodeContainer rdf:resource="#VoltageLevel_110kV_East"/>
    </cim:ConnectivityNode>

    <!-- ===== GENERATOR ===== -->
    <cim:GeneratingUnit rdf:ID="Generator_East_Solar">
        <cim:IdentifiedObject.name>East Solar Plant</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>30MW solar power plant</cim:IdentifiedObject.description>
        <cim:GeneratingUnit.maxOperatingP>30.0</cim:GeneratingUnit.maxOperatingP>
        <cim:GeneratingUnit.minOperatingP>0.0</cim:GeneratingUnit.minOperatingP>
        <cim:Equipment.EquipmentContainer rdf:resource="#Substation_East"/>
    </cim:GeneratingUnit>

    <!-- ===== LINE ===== -->
    <cim:ACLineSegment rdf:ID="Line_East_Central">
        <cim:IdentifiedObject.name>Line East-Central</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>110kV overhead line East to Central</cim:IdentifiedObject.description>
        <cim:Conductor.length>25.0</cim:Conductor.length>
        <cim:ACLineSegment.r>0.09</cim:ACLineSegment.r>
        <cim:ACLineSegment.x>0.28</cim:ACLineSegment.x>
        <cim:ConductingEquipment.BaseVoltage rdf:resource="#BaseVoltage_110kV"/>
    </cim:ACLineSegment>

    <!-- ===== LOAD ===== -->
    <cim:ConformLoad rdf:ID="Load_East_Town">
        <cim:IdentifiedObject.name>East Town Load</cim:IdentifiedObject.name>
        <cim:IdentifiedObject.description>Medium town residential load</cim:IdentifiedObject.description>
        <cim:EnergyConsumer.pfixed>40.0</cim:EnergyConsumer.pfixed>
        <cim:EnergyConsumer.qfixed>12.0</cim:EnergyConsumer.qfixed>
        <cim:Equipment.EquipmentContainer rdf:resource="#Substation_East"/>
    </cim:ConformLoad>

    <!-- ===== TERMINALS ===== -->
    <cim:Terminal rdf:ID="Terminal_Generator_East">
        <cim:Terminal.ConductingEquipment rdf:resource="#Generator_East_Solar"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Node_East_110kV_Bus"/>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Terminal_Line_East">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_East_Central"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Node_East_110kV_Bus"/>
    </cim:Terminal>

</rdf:RDF>
