<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:cim="http://iec.ch/TC57/CIM100#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <cim:BaseVoltage rdf:ID="BV_380kV">
        <cim:IdentifiedObject.name>380kV</cim:IdentifiedObject.name>
        <cim:BaseVoltage.nominalVoltage>380000</cim:BaseVoltage.nominalVoltage>
    </cim:BaseVoltage>

    <cim:Substation rdf:ID="Sub_North">
        <cim:IdentifiedObject.name>North Zone</cim:IdentifiedObject.name>
    </cim:Substation>

    <cim:Substation rdf:ID="Sub_South">
        <cim:IdentifiedObject.name>South Zone</cim:IdentifiedObject.name>
    </cim:Substation>

    <cim:GeneratingUnit rdf:ID="Wind_Farm_01">
        <cim:IdentifiedObject.name>Wind Farm 01</cim:IdentifiedObject.name>
        <cim:GeneratingUnit.maxOperatingP>250.0</cim:GeneratingUnit.maxOperatingP>
        <cim:Equipment.EquipmentContainer rdf:resource="#Sub_North"/>
    </cim:GeneratingUnit>

    <cim:EnergyConsumer rdf:ID="City_Load_01">
        <cim:IdentifiedObject.name>City Load 01</cim:IdentifiedObject.name>
        <cim:Equipment.EquipmentContainer rdf:resource="#Sub_South"/>
    </cim:EnergyConsumer>

    <cim:ACLineSegment rdf:ID="Line_N_S">
        <cim:IdentifiedObject.name>Line North-South</cim:IdentifiedObject.name>
        <cim:ACLineSegment.r>0.1</cim:ACLineSegment.r>
        <cim:ACLineSegment.x>0.4</cim:ACLineSegment.x>
        <cim:ConductingEquipment.BaseVoltage rdf:resource="#BV_380kV"/>
    </cim:ACLineSegment>

    <cim:ConnectivityNode rdf:ID="Bus_N">
        <cim:IdentifiedObject.name>Bus North</cim:IdentifiedObject.name>
    </cim:ConnectivityNode>

    <cim:ConnectivityNode rdf:ID="Bus_S">
        <cim:IdentifiedObject.name>Bus South</cim:IdentifiedObject.name>
    </cim:ConnectivityNode>

    <cim:Terminal rdf:ID="Term_Gen">
        <cim:Terminal.ConductingEquipment rdf:resource="#Wind_Farm_01"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Bus_N"/>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Term_Line_N">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_N_S"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Bus_N"/>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Term_Line_S">
        <cim:Terminal.ConductingEquipment rdf:resource="#Line_N_S"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Bus_S"/>
    </cim:Terminal>

    <cim:Terminal rdf:ID="Term_Load">
        <cim:Terminal.ConductingEquipment rdf:resource="#City_Load_01"/>
        <cim:Terminal.ConnectivityNode rdf:resource="#Bus_S"/>
    </cim:Terminal>

</rdf:RDF>